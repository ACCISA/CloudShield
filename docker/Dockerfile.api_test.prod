FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y \
    bash \
    ca-certificates \
    curl \
    gnupg \
    iputils-ping \
    mtools \
    fdisk \
    net-tools \
    procps \
    tini \
    wget \
    && curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(. /etc/os-release && echo $VERSION_CODENAME) main" > /etc/apt/sources.list.d/hashicorp.list \
    && apt-get update && apt-get install -y terraform \
    && curl -fsSL https://get.docker.com/ | sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY cloudshield/Server/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir awscli scikit-learn "elasticsearch>=8.0,<9.0" schedule psutil

RUN mkdir -p \
    /app/cloudshield \
    /app/cloudshield/RPCNode/build \
    /var/lib/cloudshield/templates \
    /var/lib/cloudshield/terraform \
    /data \
    /tmp/cloudshield-logs/jobs

COPY docker-compose.yml /app/docker-compose.yml
COPY docker /app/docker

COPY cloudshield/__init__.py /app/cloudshield/__init__.py
COPY cloudshield/Server /app/cloudshield/Server
COPY cloudshield/ThreatDetection /app/cloudshield/ThreatDetection
COPY cloudshield/Cloud/docker_provisioner /app/provisioner
COPY cloudshield/Cloud/templates /var/lib/cloudshield/templates
COPY cloudshield/RPCNode /app/cloudshield/RPCNode
COPY cloudshield/RPCNode/build/cs-rpcsrv /app/cloudshield/RPCNode/build/cs-rpcsrv

EXPOSE 5050

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "/app/cloudshield/Server/server.py"]
