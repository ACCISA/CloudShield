FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
	openvpn \
		freerdp2-x11 \
		xvfb \
	xauth \
		libcap2-bin \
		libnss3 \
		libatk-bridge2.0-0 \
		libgtk-3-0 \
		libxss1 \
		libasound2 \
		libgbm1 \
		libxshmfence1 \
		libx11-xcb1 \
		libdrm2 \
		libxcomposite1 \
		libxdamage1 \
		libxrandr2 \
		libxkbcommon0 \
		libxfixes3 \
		libglib2.0-0 \
		ca-certificates \
	&& ln -sf /usr/bin/xfreerdp /usr/local/bin/xfreerdp3 \
	&& setcap cap_net_admin,cap_net_raw+ep /usr/sbin/openvpn \
	&& rm -rf /var/lib/apt/lists/*

COPY cloudshield/DesktopUI/package*.json ./
RUN npm install

COPY cloudshield/DesktopUI .

ENV ELECTRON_DISABLE_SANDBOX=true

EXPOSE 5174

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5174"]