FROM node:22-bookworm-slim AS builder

ARG VITE_API_BASE_URL
ARG VITE_API_ACCESS_TOKEN
ARG VITE_PUBLIC_POSTHOG_KEY
ARG VITE_PUBLIC_POSTHOG_HOST
ARG VITE_POSTHOG_ENABLED
ARG VITE_STRIPE_PUBLIC_KEY

ENV CI=true \
    NODE_ENV=production \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_ACCESS_TOKEN=$VITE_API_ACCESS_TOKEN \
    VITE_PUBLIC_POSTHOG_KEY=$VITE_PUBLIC_POSTHOG_KEY \
    VITE_PUBLIC_POSTHOG_HOST=$VITE_PUBLIC_POSTHOG_HOST \
    VITE_POSTHOG_ENABLED=$VITE_POSTHOG_ENABLED \
    VITE_STRIPE_PUBLIC_KEY=$VITE_STRIPE_PUBLIC_KEY

WORKDIR /app

COPY cloudshield/WebUI/package*.json ./
RUN npm ci

COPY cloudshield/WebUI/ ./
RUN npm run build

FROM node:22-bookworm-slim

WORKDIR /app

RUN npm install -g serve@14.2.0 \
    && addgroup --system web \
    && adduser --system --ingroup web web

COPY --from=builder /app/dist /app/dist

USER web

EXPOSE 5173

CMD ["serve", "-s", "dist", "-l", "5173"]
