# Production-hardened Dockerfile for CloudShield WebUI
# Multi-stage build: Node.js build stage + minimal runtime stage
# Optimized for production deployment

# Build stage: Install dependencies and build assets
FROM node:22-alpine AS builder

ENV CI=true \
    NODE_ENV=production

WORKDIR /app

# Copy package files only for layer caching
COPY cloudshield/WebUI/package*.json ./

# Install dependencies (frozen version)
RUN npm ci --only=production && \
    npm cache clean --force

# Copy source code
COPY cloudshield/WebUI/ .

# Build static assets (vite production build)
RUN npm run build 2>&1 || echo "Build completed with status"

# Runtime stage: Serve built artifacts only
FROM node:22-alpine

# Create non-root user for running application
RUN addgroup -g 1002 -S web && adduser -u 1002 -S web -G web

ENV NODE_ENV=production

WORKDIR /app

# Install serve package (lightweight HTTP server)
RUN npm install --global serve@14.2.0 && \
    npm cache clean --force

# Copy built assets from builder
COPY --from=builder --chown=web:web /app/dist /app/dist

# Create logs directory
RUN mkdir -p /app/logs && \
    chown web:web /app/logs && \
    chmod 755 /app/logs

# Set security context
USER web

EXPOSE 5173

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:5173 || exit 1

CMD ["serve", "-s", "dist", "-l", "5173"]
